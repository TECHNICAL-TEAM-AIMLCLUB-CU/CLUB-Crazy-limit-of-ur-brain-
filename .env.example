# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Sanity (public identifiers; safe in the browser bundle)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Neon (SERVER ONLY — never prefix with NEXT_PUBLIC_)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Long random string used to salt daily visitor hashes (openssl rand -hex 32)
COUNTER_SALT=change-me
