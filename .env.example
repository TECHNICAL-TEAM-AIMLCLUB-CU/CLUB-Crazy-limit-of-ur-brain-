# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Neon (SERVER ONLY — never prefix with NEXT_PUBLIC_)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Long random string used to salt daily visitor hashes
COUNTER_SALT=replace-with-random-value

# Built-in CMS administrator (SERVER ONLY)
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=change-me
# Generate with: openssl rand -hex 32
CMS_SESSION_SECRET=change-me
